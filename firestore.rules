rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() in [
          'support@traveliumglobal.com',
          'traveliumgrobal@gmail.com',
          'samlite250@gmail.com'
        ] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    // ── Admins ──
    match /admins/{email} {
      allow read, write: if request.auth != null;
    }

    // ── Applications ──
    match /applications/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource.data.user_id == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── User profiles ──
    match /users/{uid} {
      allow read, create: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // ── Services ──
    match /services/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Contact messages ──
    match /contacts/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Leads (public checklist / deadline-reminder signups from detail pages) ──
    match /leads/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Outbound apply clicks (anonymous click analytics from detail pages) ──
    match /outbound_clicks/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    // ── Transactions ──
    match /transactions/{docId} {
      allow read: if request.auth != null && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ── Site settings ──
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Auto-import pipeline (admin review queue) ──
    match /imported_listings/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ── Live auto-imported jobs (public read of active listings) ──
    match /jobs/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
